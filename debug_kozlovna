import requests
from bs4 import BeautifulSoup

URL = "https://www.holesovickakozlovna.cz/"
headers = {"User-Agent": "Mozilla/5.0"}  # použijte stejné jako ve scraperu

resp = requests.get(URL, headers=headers, timeout=30)
print("status:", resp.status_code, "| délka:", len(resp.text), "| finální URL:", resp.url)

with open("debug_kozlovna.html", "w", encoding="utf-8") as f:
    f.write(resp.text)

soup = BeautifulSoup(resp.text, "html.parser")
text = soup.get_text("\n", strip=True)
print("Obsahuje 'polévk':", "polévk" in text.lower())
print("Obsahuje 'menu':", "menu" in text.lower())
print("--- prvních 1500 znaků textu ---")
print(text[:1500])